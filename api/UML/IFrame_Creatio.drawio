        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Service {\n        +isDomainActive(domain: Domain) bool\n        +isHTTPS(request: Request) bool\n        +isRequestValid(request: Request) bool\n    }\n\n    class Partner {\n        +hasValidID(partnerID: String) bool\n        +isAccountActive(partnerID: String) bool\n        +canSubmitRequest(partnerID: String) bool\n    }\n\n    class Domain {\n        +isWhitelisted(domain: String) bool\n        +getStatus(domain: String) String\n    }\n\n    class Database {\n        +getPartnerID(partnerID: String) String\n        +getAccountStatus(partnerID: String) String\n    }\n\n    class Request {\n        +isFileAllowed() bool\n        +isValidSubmission() bool\n        +isOneRequestPerDay(partnerID: String) bool\n    }\n\n    class IFrame {\n        +show() void\n        +hide() void\n    }\n\n    Service --|&gt; Domain : Checks domain status\n    Service --|&gt; Request : Validates request\n    Partner --|&gt; Service : Interacts with service using partnerID\n    Partner --|&gt; Domain : Interacts through whitelisted domain\n    Partner --|&gt; Database : Checks partner ID and account status\n    Partner --|&gt; IFrame : Can show IFrame\n    Request --|&gt; Partner : Partner submits request\n    Request --|&gt; IFrame : Decision to show IFrame based on conditions\n\n    %% Relationships\n    Service : &lt;&lt;singleton&gt;&gt;\n    Database : &lt;&lt;singleton&gt;&gt;\n\n    %% Methods with conditions\n    Service : +isDomainActive(domain)\n    Service : +isHTTPS(request)\n    Service : +isRequestValid(request)\n    Partner : +hasValidID(partnerID)\n    Partner : +isAccountActive(partnerID)\n    Partner : +canSubmitRequest(partnerID)\n    Request : +isFileAllowed()\n    Request : +isValidSubmission()\n    Request : +isOneRequestPerDay(partnerID)\n\n    %% Show/Hide IFrame based on conditions\n    IFrame : +show()\n    IFrame : +hide()\n&quot;&#xa;}" id="P_4PPFSMZPd1eqaG8Fmj-136">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;imageBackground=#DFBFFF;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
